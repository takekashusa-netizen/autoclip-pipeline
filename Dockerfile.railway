# api.takekash.com — FastAPI pipeline API + Clip Studio (Railway service "api")
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg tesseract-ocr tesseract-ocr-eng nodejs \
      libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY web/requirements.txt web/requirements.txt
COPY worker/requirements.txt worker/requirements.txt
RUN pip install --no-cache-dir -r web/requirements.txt -r worker/requirements.txt \
      numpy opencv-python-headless pillow anthropic
COPY . .
RUN chmod +x *.sh skills/*.sh skills/*/run.sh 2>/dev/null || true
# Persist jobs/outputs on the Railway volume mounted at /data
CMD mkdir -p /data/projects /data/outputs && rm -rf projects outputs \
    && ln -s /data/projects projects && ln -s /data/outputs outputs \
    && uvicorn web.main:app --host 0.0.0.0 --port ${PORT:-8000}
